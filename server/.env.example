# ============================================
# CONFIGURAÃ‡ÃƒO DO BANCO DE DADOS
# ============================================

# Tipo de Banco de Dados (sqlite ou postgres)
DB_TYPE=sqlite

# SQLite (PadrÃ£o - Recomendado para Desenvolvimento)
SQLITE_DB_PATH=./tidesk.db

# PostgreSQL (Recomendado para ProduÃ§Ã£o)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tidesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false

# ============================================
# CONFIGURAÃ‡ÃƒO DO SERVIDOR
# ============================================

PORT=5000
JWT_SECRET=tidesk-secret-key-change-in-production
NODE_ENV=development

# ============================================
# USUÃRIO ADMINISTRADOR PADRÃƒO
# ============================================
# Estas credenciais serÃ£o usadas para criar o usuÃ¡rio admin inicial
# IMPORTANTE: Altere estas credenciais em produÃ§Ã£o!

ADMIN_EMAIL=admin@tidesk.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# ============================================
# BACKUP AUTOMATICO
# ============================================
# So inicia o agendador de backup ao subir o servidor se ENABLE_BACKUP_SCHEDULER=true
# Por padrao nao inicia (dev/start sem backup automatico). Em producao, defina true para ativar.
# ENABLE_BACKUP_SCHEDULER=false

# ============================================
# CONFIGURAÃ‡ÃƒO DE EMAIL (SMTP)
# ============================================
# Configure estas variÃ¡veis para habilitar o envio de backups por email
# IMPORTANTE: Para Gmail, use "Senha de App" (nÃ£o a senha normal)
# Acesse: https://myaccount.google.com/apppasswords

SMTP_HOST=mail.invicco.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tidesk@invicco.com.br
SMTP_PASSWORD=sua-senha
SMTP_FROM_EMAIL=tidesk@invicco.com.br
SMTP_FROM_NAME=TIDESK Backup

# ============================================
# NOTIFICACAO SLACK (NOVOS TICKETS)
# ============================================
# URL do Incoming Webhook do Slack. Se vazio, notificacao fica desativada.
# Tickets criados via Webhooks (integracoes externas) NAO disparam esta notificacao.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ============================================
# ASSISTENTE DE IA (PDF DE ORDEM DE SERVICO -> TICKET)
# ============================================
# Usadas apenas como valor inicial na primeira leitura de config/ai-config.json.
# Depois de configuradas uma vez pela tela /config/ia, essas variaveis sao ignoradas.
# Ordem de fallback fixa: Groq -> OpenRouter -> Gemini.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ============================================
# CONSULTA OS-SIGMA (SQL Server Sigma90 - somente leitura)
# ============================================
SIGMA_MSSQL_HOST=192.168.1.247
SIGMA_MSSQL_PORT=1433
SIGMA_MSSQL_USER=bi_leitura_sigma
SIGMA_MSSQL_PASSWORD=sua-senha
SIGMA_MSSQL_DATABASE=SIGMA90
